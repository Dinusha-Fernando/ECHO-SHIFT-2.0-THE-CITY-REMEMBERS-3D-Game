# =====================================================================
# ECHO//SHIFT - Environment Configuration Template
# =====================================================================
# NOTE: Copy this file to '.env' (or '.env.local') and replace the placeholder
# values with your real credentials.
#
# DO NOT commit real secrets or production credentials to version control.
# '.env.example' is safe to commit because it contains placeholders.
# =====================================================================

# ---------------------------------------------------------------------
# Security & Secret Keys
# ---------------------------------------------------------------------
SECRET_KEY=change-me
API_KEY=your-api-key-here
PRIVATE_KEY=your-private-key-here
ACCESS_TOKEN_SECRET=your-token-secret-here

# ---------------------------------------------------------------------
# Database Connection
# ---------------------------------------------------------------------
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://user:password@localhost/database

# ---------------------------------------------------------------------
# Server Configuration (FastAPI / Uvicorn)
# ---------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=False
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------
# Client Configuration (Next.js Public Variables)
# ---------------------------------------------------------------------
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
